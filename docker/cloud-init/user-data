#cloud-config
# NoCloud user-data for this blue-ot container.
#
# Replace the contents here, or mount your own seed over
# /var/lib/cloud/seed/nocloud, to provision the container at boot. The examples
# below are inert until you uncomment them. After editing, re-provisioning needs
# a fresh instance-id (change meta-data) or `cloud-init clean --logs && reboot`.

write_files:
  - path: /etc/blue-ot/cloud-init.txt
    permissions: '0644'
    content: |
      This container was provisioned by cloud-init (NoCloud datasource).

